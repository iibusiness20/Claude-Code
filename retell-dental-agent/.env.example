# ============================================================================
# ENVIRONMENT VARIABLES — RETELL DENTAL AGENT
# ============================================================================
# Copy this file to .env and fill in your actual values.
# Command: cp .env.example .env
# ============================================================================

# ----------------------------------------------------------
# RETELL AI
# Get your API key from https://dashboard.retellai.com
# ----------------------------------------------------------
RETELL_API_KEY=your_retell_api_key

# ----------------------------------------------------------
# CAL.COM
# Get your API key from https://app.cal.com/settings/developer/api-keys
# Event type IDs are found in Cal.com under each event type's settings.
# ----------------------------------------------------------
CALCOM_API_KEY=your_calcom_api_key
CALCOM_BASE_URL=https://api.cal.com/v2
CALCOM_DENTIST_EVENT_ID=
CALCOM_PHYSIO_EVENT_ID=
CALCOM_MASSAGE_EVENT_ID=
CALCOM_ACUPUNCTURE_EVENT_ID=

# ----------------------------------------------------------
# EMAIL (SMTP)
# For Gmail: use an App Password (not your regular password).
# Go to Google Account → Security → 2-Step Verification → App Passwords.
# For Brevo: use your Brevo SMTP credentials.
# ----------------------------------------------------------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your_email@gmail.com
SMTP_PASS=your_app_password
EMAIL_FROM=reception@clinic.com

# ----------------------------------------------------------
# SMS (TWILIO)
# Optional — SMS will be skipped if these are not set.
# Get a free trial account at https://www.twilio.com
# ----------------------------------------------------------
TWILIO_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=

# ----------------------------------------------------------
# SERVER
# ----------------------------------------------------------
PORT=3000
